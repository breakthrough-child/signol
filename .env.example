# ---- Supabase (required) -------------------------------------------------
# Project settings > API. The anon key is public by design; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ---- Models (free tiers) ---------------------------------------------------
# Primary: Groq (https://console.groq.com/keys). Fallback: Google Gemini (https://aistudio.google.com/apikey).
# At least one key is required for a live analysis. Never commit real keys.
GROQ_API_KEY=YOUR_GROQ_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Model IDs live here, not in code, because free-tier catalogues change. Check each provider's
# current docs/limits page and override if these are retired. (Defaults are NOT verified against live docs.)
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
GEMINI_MODEL=gemini-2.5-flash

# Order in which providers are tried; the next one is used on rate limits, errors or invalid JSON.
LLM_PROVIDER_ORDER=groq,gemini

# ---- Testing / development only -------------------------------------------
# Force a provider to fail to test the fallback, e.g. LLM_FORCE_FAIL=groq
# LLM_FORCE_FAIL=
# Offline heuristic provider (NOT a language model) for UI development without keys:
# LLM_PROVIDER_ORDER=mock
# Optional overrides for the e2e fakes:
# GROQ_BASE_URL=
# GEMINI_BASE_URL=
# DATABASE_URL=   # only for scripts/report-runlogs.mts
